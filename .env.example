# Contact form (Resend). Without RESEND_API_KEY the form logs submissions in
# development and shows an "email us instead" message in production.
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to hello@weareyield.digital.
CONTACT_TO_EMAIL=
# Sender; must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Yield Website <website@weareyield.digital>"
